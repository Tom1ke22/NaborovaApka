# Access log bez query stringu a bez Referer. Štandardný formát loguje celý
# $request, teda aj ?parametre. Kedysi v nich bol session_id chatu a kto ho
# mal, vedel si cudzí rozhovor pripojiť k vlastnej prihláške. Do logov preto
# ide len cesta, aby sa sem tajomstvo nedostalo ani v budúcnosti.
#
# Cesta sa berie z $request_uri (to, čo poslal klient), nie z $uri. Ten sa po
# try_files zmení na /index.html a v logu by boli všetky stránky rovnaké.
#
# Obmedzenie: error_log formát nastaviť nevie. Pri chybe upstreamu (502)
# vypíše celý request aj s query stringom. Preto tajomstvá do URL nepatria
# vôbec, tento formát je len druhá poistka.
map $request_uri $request_path {
    ~^(?<path>[^?]*) $path;
}
log_format noquery '$remote_addr - [$time_local] "$request_method $request_path $server_protocol" '
                   '$status $body_bytes_sent "$http_user_agent"';

server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    access_log /var/log/nginx/access.log noquery;

    # Bezpečnostné hlavičky (CSP, X-Frame-Options, nosniff, Referrer-Policy…).
    # POZOR: add_header sa dedí len do location, ktorá nemá žiadny vlastný
    # add_header. Každá location s vlastným add_header musí include zopakovať.
    include /etc/nginx/snippets/security-headers.conf;

    # React Router — všetky neznáme cesty vrátia index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Statické assety — dlhé cachovanie (Vite pridáva hash do názvu)
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/snippets/security-headers.conf;
    }

    # API proxy → backend
    # BACKEND_URL sa nastaví cez env premennú (napr. http://backend:8000 lokálne,
    # alebo https://backend-xxx.run.app na GCP)
    location /api/ {
        # Default nginx je 1 MB, backend berie CV do 10 MB (MAX_CV_SIZE_BYTES).
        # Rezerva navyše je na multipart obálku a ostatné polia formulára.
        client_max_body_size 11m;

        proxy_pass ${BACKEND_URL}/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # SSE (chat streaming) — zakáž buffering aby chunky šli okamžite
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
    }
}
