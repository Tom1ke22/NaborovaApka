server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # React Router — všetky neznáme cesty vrátia index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Statické assety — dlhé cachovanie (Vite pridáva hash do názvu)
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # API proxy → backend
    # BACKEND_URL sa nastaví cez env premennú (napr. http://backend:8000 lokálne,
    # alebo https://backend-xxx.run.app na GCP)
    location /api/ {
        proxy_pass ${BACKEND_URL}/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # SSE (chat streaming) — zakáž buffering aby chunky šli okamžite
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
    }
}
