# Databáza
# Lokálne:   postgresql+asyncpg://postgres:postgres@db:5432/recruitment_db
# Cloud Run: postgresql+asyncpg://USER:PASS@/DB?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/recruitment_db

# JWT — zmeň na silný náhodný reťazec v produkcii
# Generuj: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=zmen-toto-na-nahodny-retazec-v-produkcii
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Prostredie: "development" | "production"
# production = JSON logy, vypnutý /api/docs
# Keď ENV chýba, appka beží ako production. Tento súbor je šablóna pre
# lokálny vývoj, preto tu je development. Na Cloud Run ENV nenastavuj
# alebo nastav production.
ENV=development

# Výpis SQL príkazov do logu (SQLAlchemy echo). Logujú sa aj parametre,
# teda osobné údaje uchádzačov a hashe hesiel. Len na lokálne ladenie,
# pri ENV=production sa ignoruje.
SQL_ECHO=false

# Rate limiting za reverznou proxy (nginx, Cloud Run)
# Zapni LEN ak pred appkou skutočne stojí proxy, ktorej veríš — inak si
# ktokoľvek obíde limit podvrhnutou hlavičkou X-Forwarded-For.
# TRUSTED_PROXY_HOPS = počet vlastných proxy medzi klientom a appkou:
#   nginx na tom istom hostovi alebo priamy *.run.app URL  -> 0
#   Cloud Run za externým HTTP(S) load balancerom          -> 1
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_HOPS=0

# CORS — čiarkami oddelené origins prehliadača
# Lokálne:   http://localhost:5173,http://localhost:3000
# Cloud Run: https://naborovaapka.sk
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Úložisko CV súborov: "local" | "gcs"
STORAGE_BACKEND=local

# GCS (vyplň len ak STORAGE_BACKEND=gcs)
GCS_BUCKET_NAME=
GOOGLE_APPLICATION_CREDENTIALS=

# AI (Gemini) – chatbot pre uchádzačov a hodnotenie životopisov
# Kľúč sa vydáva v Google AI Studio: https://aistudio.google.com/apikey
# Bez kľúča appka normálne beží: chatbot odpovie záložnou vetou
# a uchádzači ostanú bez skóre.
AI_ENABLED=true
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_EXTRACTION_MODEL=gemini-3.1-flash-lite

# Záchranná brzda proti vyčerpaniu kreditu: strop na počet volaní modelu za deň.
# 0 = bez stropu. Platí na instanciu procesu a po restarte sa nuluje, takže to
# NENAHRADZUJE billing budget a kvóty (requests/min, requests/deň) nastavené
# v Google Cloud — tie sú jediná skutočne tvrdá hranica.
AI_DAILY_CALL_LIMIT=0
