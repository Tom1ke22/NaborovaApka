# Databáza
# Lokálne:   postgresql+asyncpg://postgres:postgres@db:5432/recruitment_db
# Cloud Run: postgresql+asyncpg://USER:PASS@/DB?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/recruitment_db

# JWT — zmeň na silný náhodný reťazec v produkcii
# Generuj: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=zmen-toto-na-nahodny-retazec-v-produkcii
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Prostredie: "development" | "production"
# production = JSON logy, vypnutý /api/docs
ENV=development

# CORS — čiarkami oddelené origins prehliadača
# Lokálne:   http://localhost:5173,http://localhost:3000
# Cloud Run: https://naborovaapka.sk
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Úložisko CV súborov: "local" | "gcs"
STORAGE_BACKEND=local

# GCS (vyplň len ak STORAGE_BACKEND=gcs)
GCS_BUCKET_NAME=
GOOGLE_APPLICATION_CREDENTIALS=
