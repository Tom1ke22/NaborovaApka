# Databáza
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/recruitment_db

# JWT
JWT_SECRET=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Google Cloud Storage
GCS_BUCKET_NAME=
GOOGLE_APPLICATION_CREDENTIALS=

# AI (Gemini) – chatbot pre uchádzačov a hodnotenie životopisov
# Kľúč sa vydáva v Google AI Studio: https://aistudio.google.com/apikey
# Bez kľúča appka normálne beží: chatbot odpovie záložnou vetou
# a uchádzači ostanú bez skóre.
AI_ENABLED=true
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_EXTRACTION_MODEL=gemini-3.1-flash-lite

# Prostredie
ENV=development
